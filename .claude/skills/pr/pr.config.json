{
  "baseBranch": "main",
  "template": ".github/pull_request_template.md",
  "activate": "source ~/.nvm/nvm.sh && nvm use",
  "planSkill": "tech-plan",
  "worktreeSkill": "worktree",
  "lessons": "docs/lessons",
  "checkBar": "docs/README.md#checked-conventions",
  "review": {
    "copilot": null,
    "skipWhenOnly": ["README.md", "docs/"],
    "adversarialAgent": "adversarial-reviewer",
    "adversarialWhenAny": [
      ".github/workflows/**",
      ".husky/**",
      "scripts/**",
      "lint-staged.config.js",
      "commitlint.config.js",
      ".oxlintrc.json",
      ".prettierrc",
      ".prettierignore",
      "tsconfig*.json"
    ],
    "editorialAgent": "editorial-reviewer",
    "editorialWhenAny": ["**"]
  }
}
